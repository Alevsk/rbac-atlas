# Optional environment overrides for local development.
# Nothing loads this file automatically: copy it to .env (git-ignored) and export it,
# e.g. `set -a; . ./.env; set +a`, or use direnv.

# Image vulnerability pipeline (see docs/image-vulns.md)
# Working directory for scan outputs and caches (default: vulns)
# VULNS_DIR=vulns
# Paths to the scanner binaries when they are not on PATH
# TRIVY=/path/to/trivy
# CRANE=/path/to/crane
