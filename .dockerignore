# Allowlist: the build context only carries what the Dockerfile uses.
# Everything else (charts/ ~25 GB, public/, manifests/, reports/, vulns/, .venv,
# node_modules, tests, docs, CI config, .git, .env) stays out of the context.
*

# Dependency manifests and lockfiles
!package.json
!package-lock.json
!pyproject.toml
!uv.lock
!report/pyproject.toml

# Tool and server configuration
!.djlintrc
!nginx.conf

# Hugo site sources
!config.toml
!config.*.toml
!archetypes
!assets
!content
!data
!layouts
!static
!themes

# Junk that may live inside the allowed directories
**/.DS_Store
**/Thumbs.db
**/node_modules
**/__pycache__
themes/*/exampleSite
